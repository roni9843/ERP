# Copy to .env (never commit .env). Validated at startup by src/config/env.ts.
NODE_ENV=development
PORT=4000

# Must be a replica set (transactions). docker compose starts one at localhost:27017.
MONGODB_URI=mongodb://localhost:27017/erp?replicaSet=rs0&directConnection=true

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# Access token lifetime: <number><s|m|h|d>
JWT_ACCESS_TTL=15m

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
